# Copy to .env for local development. Never commit .env.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=xxxxxxxx
ENTRA_TENANT=consumers
BASE_URL=http://localhost:8000
JWT_SIGNING_KEY=change-me-to-32-plus-random-bytes
TOKEN_STORE=file
TOKEN_FILE=.graph_token.json
TIME_ZONE=Singapore Standard Time
WEBHOOK_CLIENT_STATE=change-me-random
WEBHOOK_RESOURCES=/me/mailFolders('inbox')/messages,/me/events
LOG_LEVEL=INFO
